# Backend API base URL. Leave unset for local dev — Vite's dev server
# proxies relative /api/* requests to http://localhost:4100 (see
# vite.config.js). Required for production builds: the API lives on its own
# origin (a Firebase Hosting site that rewrites to the `api` Cloud Function).
VITE_API_BASE_URL="https://api.keyshops.in"

# Google Analytics 4 measurement ID (e.g. "G-XXXXXXXXXX"). Leave unset to
# skip loading GA entirely - see src/utils/analytics.js. Get this from your
# GA4 property under Admin > Data Streams > your web stream.
VITE_GA_MEASUREMENT_ID=""
