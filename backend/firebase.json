{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "sync"
    },
    {
      "source": "functions-api",
      "codebase": "api",
      "runtime": "nodejs22",
      "predeploy": [
        "npm run build",
        "node scripts/prepare-functions-api.js"
      ],
      "ignore": ["node_modules", ".git"]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
