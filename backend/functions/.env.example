# Same Algolia Application ID the backend uses (backend/.env's
# ALGOLIA_APP_ID). Safe to duplicate here - it's a public identifier, not a
# secret.
ALGOLIA_APP_ID=

# Algolia's ADMIN API key (full write access to every index) - from the
# Algolia dashboard → Settings → API Keys. NOT the same as the backend's
# ALGOLIA_SEARCH_API_KEY (search-only) - never put the admin key in
# backend/.env, and never put the search key here.
ALGOLIA_ADMIN_API_KEY=
