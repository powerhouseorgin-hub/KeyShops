# Local development / scripts only. The deployed Cloud Function reads backend/functions-api/.env instead
# (gitignored; see scripts/prepare-functions-api.js). Copy this file to backend/.env and fill it in.
# NEVER commit real values.

# --- Firebase (project keee-7d6cb: Firestore, Auth, Storage) -------------------------------------------------
# Service-account key as a single-line JSON string (Firebase console -> Project settings -> Service accounts).
# Not needed when running against the Firestore/Auth emulators (set the *_EMULATOR_HOST variables below).
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Web API key of the Firebase project - used server-side for the email+password sign-in REST call.
FIREBASE_WEB_API_KEY=""
# Cloud Storage bucket for customer/shop documents and promotion/ad images (e.g. keee-7d6cb.firebasestorage.app).
FIREBASE_STORAGE_BUCKET=""
# Emulators (optional): e.g. 127.0.0.1:8080 and 127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=""
FIREBASE_AUTH_EMULATOR_HOST=""

# --- Application secrets -------------------------------------------------------------------------------------
# AES-256-GCM key for customer Aadhaar / ID-proof numbers: 64 hex chars (32 bytes). Required in production
# (the server refuses to start without it); a fixed dev key is used locally if unset.
ENCRYPTION_KEY=""
PORT=4000
NODE_ENV=development
# Public base URL of the API, used to build document-download links sent over WhatsApp.
PUBLIC_API_BASE_URL="http://localhost:4100"

# --- Algolia (search for customers / shops / promotions) -----------------------------------------------------
ALGOLIA_APP_ID=""
ALGOLIA_SEARCH_API_KEY=""   # search-only key, used by the API at request time
ALGOLIA_ADMIN_API_KEY=""    # admin key, used only by scripts/reindex-algolia.ts (never deployed with the API)

# --- LocationIQ (reverse geocoding proxy) --------------------------------------------------------------------
LOCATIONIQ_API_KEY=""

# --- WhatsApp Business Cloud API (OTP + invoice delivery). Leave unset to run fail-soft. ---------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE_NAME=""        # approved "Authentication" template
WHATSAPP_INVOICE_TEMPLATE_NAME=""    # approved "Utility" template with a document header
WHATSAPP_VEHICLE_RECEIPT_TEMPLATE_NAME=""  # optional: Utility template with the same shape worded for vehicle receipts (keyshops_vehicle_receipt)
WHATSAPP_API_VERSION="v21.0"
# Daily health check (scheduled function whatsappHealthCheck + GET /super/whatsapp-health): the WhatsApp Business account that owns the
# business number, and the Meta app id that must stay subscribed to it. Without the account id the check reports it as a problem.
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_ID=""

# --- Email codes (verify an email address, a customer's email, and password reset by a verified email). Two ways; leave both unset to run
# fail-soft (the app then says the email could not be sent).
# 1) DIRECT - no email provider: our own code finds the recipient's mail server in DNS and delivers, signed with our DKIM key. Must run
#    where outbound port 25 is open (NOT Cloud Functions / Cloud Run, which block it) and needs SPF + DKIM + DMARC + reverse DNS.
#    Create the key and see the DNS records with:  npx ts-node scripts/generate-dkim.ts keyshops.in mail
EMAIL_DIRECT=""                      # "true" to turn it on
EMAIL_HELO_HOSTNAME=""               # the sending server's own name, e.g. mail.keyshops.in (its reverse DNS must match)
DKIM_DOMAIN=""
DKIM_SELECTOR=""
DKIM_PRIVATE_KEY=""                  # the key file's text with line breaks written as 

# 2) RELAY - hand the message to any SMTP service (Brevo, Amazon SES, Gmail with an app password ...). Works from anywhere, including
#    Cloud Functions. Wins over DIRECT when both are set.
SMTP_HOST=""
SMTP_PORT="587"                      # 587 = STARTTLS, 465 = SSL
SMTP_USER=""
SMTP_PASS=""
# Optional BACKUP mailboxes (suffix _2 ... _5), used in order when the one above refuses (e.g. Gmail's ~500-a-day limit is reached). The host
# and port above are used unless SMTP_HOST_2 / SMTP_PORT_2 are given; EMAIL_FROM_2 defaults to "Key Shops <the mailbox>".
# A mailbox that refused is left alone for an hour. Use mailboxes dedicated to Key Shops.
# SMTP_USER_2=""
# SMTP_PASS_2=""
# SMTP_USER_3=""
# SMTP_PASS_3=""
# Needed by both:
EMAIL_FROM="Key Shops <no-reply@keyshops.in>"
# No template yet? "true" = inbound flow: the user sends "KEYSHOPS <ref>" to the business number from the number they
# entered, and the webhook replies with the code. Needs the app Live + subscribed to the WABA + WHATSAPP_APP_SECRET below.
WHATSAPP_OTP_INBOUND=""
WHATSAPP_BUSINESS_NUMBER=""          # country code + number, digits only, e.g. 919025088853
# Webhook receiver: https://<api>/api/webhooks/whatsapp. The verify token is any random string you also type into
# Meta's dashboard (WhatsApp -> Configuration). The app secret (App settings -> Basic) is optional: when set, posted
# events are signature-checked and unsigned ones rejected.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# LOCAL TESTING ONLY: with this "true" AND the Firebase emulator running (FIRESTORE_EMULATOR_HOST), send-otp returns the
# code so the smoke tests can sign up. Ignored by a deployed API - never set it in functions-api/.env.
OTP_SHOW_CODE_IN_UI=""

# --- Razorpay (shop registration / subscription payment) -----------------------------------------------------
# Key ID is returned to the client by /api/payment/create-order; the secret must never leave the backend.
# The local standalone server and the smoke-test bootstrap deliberately DROP these two on startup so a local
# run can never create a live order.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# --- Scripts -------------------------------------------------------------------------------------------------
# Base URL the smoke-test scripts call (default: the local bootstrap server on :4100).
SMOKE_TEST_BASE_URL="http://127.0.0.1:4100"
