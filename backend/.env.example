# Supabase Postgres. DATABASE_URL is the pooled connection (port 6543,
# Supavisor/pgbouncer transaction mode) used at runtime; DIRECT_URL is the
# direct connection (port 5432) used only for `prisma migrate` (the pooler
# doesn't support the prepared statements migrations need). Both come from
# Supabase dashboard → Project Settings → Database → Connection string.
# For local dev (plain Postgres via docker-compose) both can be the same URL.
DATABASE_URL="postgresql://postgres:password@localhost:5435/keedb?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5435/keedb?schema=public"
JWT_SECRET="your-jwt-secret-key"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" # 64 hex chars (32 bytes)
PORT=4000
NODE_ENV=development

# Customer/shop document uploads (photos, ID/license PDFs) via Supabase
# Storage. Leave unset for local dev — falls back to local disk
# (public/uploads). On ephemeral hosts (Render, Railway, Cloud Run) this MUST
# be configured, since local disk doesn't survive container restarts/redeploys.
#   SUPABASE_URL              — Project Settings → API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY — Project Settings → API → service_role key
#     (NOT the anon key — uploads/deletes run server-side and must bypass
#     the bucket's RLS policies)
#   SUPABASE_STORAGE_BUCKET   — name of a private bucket created in
#     Storage → New bucket (keep "Public bucket" OFF; files are served via
#     short-lived signed URLs generated by the backend, not public links)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="kee-documents"

# Auto-seeded Super Admin (created once, only if zero Super Admins exist in
# the DB). Leave unset for local dev to use the default admin@kee.com /
# adminpassword — ALWAYS set real values in production.
SEED_SUPER_ADMIN_EMAIL="admin@kee.com"
SEED_SUPER_ADMIN_PASSWORD="adminpassword"
SEED_SUPER_ADMIN_NAME="KEE Platform Administrator"

# Real email OTP delivery (SMTP). Leave unset to fall back to console-logged
# dev OTP codes.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="\"KEE Key Space Platform\" <no-reply@kee.com>"

# Real SMS OTP delivery (Twilio). Leave unset to fall back to console-logged
# dev OTP codes.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Razorpay (shop registration payment). Key ID is safe to expose to the
# frontend (it's sent back by /api/payment/create-order); Key Secret must
# NEVER leave the backend - it's used only to create orders server-side and
# to HMAC-verify the payment signature in AuthService.registerShop before a
# shop account is ever created. Dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
