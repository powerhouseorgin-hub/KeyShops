datasource db {
  provider  = "postgresql"
  // Supabase's pooled connection (port 6543, Supavisor/pgbouncer transaction
  // mode) — used for normal runtime queries. It doesn't support the prepared
  // statements Prisma needs for migrations, so DIRECT_URL (port 5432) is used
  // for `prisma migrate` instead. Both point at plain local Postgres in dev.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SHOP_ADMIN
}

enum Plan {
  TRIAL
  MONTHLY
  HALF_YEARLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum AdType {
  POPUP
  BANNER
  NOTICE
  // Full-screen poster shown every time the native app is opened or
  // resumed from the background - see AdService.getPublicAppPoster().
  APP_POSTER
}

enum PromotionType {
  AD
  PRODUCT
  OFFER
}

model User {
  id           String        @id @default(uuid())
  // Nullable - shop self-registration no longer requires an email address
  // (see AuthService.registerShop/RegisterShopDto), so a Shop Admin may only
  // have a phone login identifier. Still unique when present; Postgres
  // allows multiple NULLs under a unique constraint, same as `phone` below.
  email        String?       @unique
  // Login identifier alternative to email - a Shop Admin can sign in with
  // either their email or mobile number using the same password (see
  // AuthService.login). Nullable/unique: Super Admin accounts have no phone,
  // and Postgres allows multiple NULLs under a unique constraint. Captured
  // on the public self-registration wizard (see AuthService.registerShop).
  phone        String?       @unique
  passwordHash String
  name         String
  role         Role
  shopId       String?
  shop         Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]
  promotions   Promotion[]

  // Soft delete: a non-null value means this record is deactivated/deleted but
  // retained for audit/referential-integrity purposes. All reads made through
  // TenantService.prisma automatically exclude rows where deletedAt is set.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([deletedAt])
}

model Shop {
  id             String  @id @default(uuid())
  name           String
  companyDetails String? // Stores JSON or text details (GST, address, city, state, pinCode, phone, etc. - NOT documents, see ShopDocument)
  themeColor     String  @default("#9C27B0")
  isActive       Boolean @default(true)
  storageUsed    BigInt  @default(0) // bytes

  // Owner's Aadhaar (Indian ID) number, captured as a plain 12-digit number
  // field on the public self-registration wizard's Step 1 (screenshot-driven
  // redesign) rather than as an uploaded document. Encrypted at rest via
  // CryptoService, mirroring Customer.idProofNumber's pattern - see
  // AuthService.registerShop().
  aadhaarNumber String?

  // GPS coordinates captured via the "Current Location" button on the public
  // self-registration wizard's Shop Details step (see captureShopLocation in
  // App.jsx). Nullable/optional: a shop owner can type the address manually
  // without granting location permission, and pre-existing shops created
  // before this field existed have neither value.
  latitude  Float?
  longitude Float?

  // Type of shop being registered (e.g. "Dealers"), picked from the list of
  // categories a Super Admin curates via the Shop Categories screen (see
  // ShopCategoryService) and selected on the public self-registration
  // wizard's Basic Details step. Nullable/SetNull so deleting a category
  // doesn't cascade-delete the shops that reference it - they just become
  // uncategorized.
  categoryId String?
  category   ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // This shop's own shareable referral code - simply its admin's registered
  // mobile number (not a random string), set for every shop at registration
  // time (see AuthService.registerShop) since phone numbers are already
  // guaranteed unique across shops. Pre-existing shops created before this
  // existed fall back to lazy generation the first time they open Shop
  // Settings or tap "Refer" (see ShopService.getOrCreateReferralCode).
  // Unique so it can be looked up unambiguously when another shop enters it
  // during self-registration.
  referralCode String? @unique

  // The referral code (if any) THIS shop entered during its own self-registration,
  // i.e. whose shop referred them. Plain string, not a FK, so history survives even
  // if the referring shop's code later changes - mirrors Customer.keyType's pattern.
  referredByCode String?

  // Running points balance earned by referring other shops - incremented by
  // AuthService.registerShop when a new shop signs up with this shop's
  // referralCode. Kept as a simple balance separate from the Referral ledger
  // below so future redemption features can debit it without rewriting history.
  referralPoints Int @default(0)

  users         User[]
  subscriptions Subscription[]
  customers     Customer[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  masterKeys    MasterKey[]
  documents     ShopDocument[]
  promotions    Promotion[]

  // Referrals this shop has made (as the referrer) and, if it was itself
  // referred, the single Referral row recording that.
  referralsMade  Referral[] @relation("ReferralsMade")
  referredByRow  Referral?  @relation("ReferralsReceived")

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([categoryId])
  // Backs the public Dealers/Find-a-Shop directory's cursor pagination -
  // WHERE isActive = true ORDER BY createdAt DESC - see ShopService.searchPublicShops.
  @@index([isActive, createdAt])
  // Backs the Super Admin Shop Management screen's cursor pagination -
  // unlike the public directory above, this has no isActive filter (Super
  // Admin manages suspended shops too), just the soft-delete filter - see
  // ShopService.getShops.
  @@index([deletedAt, createdAt])
}

// Append-only ledger recording each successful referral: one row per
// referred shop (referredShopId is unique), created atomically alongside the
// referrer's +1 referralPoints credit in AuthService.registerShop.transaction.
// The unique constraint on referredShopId is what guarantees a shop can only
// ever award its referrer once, however many times this code path runs.
model Referral {
  id String @id @default(uuid())

  referrerShopId String
  referrerShop   Shop   @relation("ReferralsMade", fields: [referrerShopId], references: [id], onDelete: Cascade)

  referredShopId String @unique
  referredShop   Shop   @relation("ReferralsReceived", fields: [referredShopId], references: [id], onDelete: Cascade)

  pointsAwarded Int @default(1)

  createdAt DateTime @default(now())

  @@index([referrerShopId])
}

// Super-Admin-managed reference list of shop "types" (e.g. Dealers) offered
// as a dropdown on the public self-registration wizard - see
// ShopCategoryController/Service. A "Dealers" row is seeded by migration so
// the dropdown is never empty out of the box.
model ShopCategory {
  id   String @id @default(uuid())
  name String @unique

  // Super Admin-controlled display order for the public self-registration
  // wizard's Category dropdown (see ShopCategoryService.getAllCategories'
  // orderBy and the reorderCategories drag-and-drop endpoint) - defaults to
  // 0 so existing rows sort first/stably until explicitly reordered.
  sortOrder Int @default(0)

  shops Shop[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([sortOrder])
}

// Super-Admin-managed reference list of Inventory "product types" (e.g. Key
// Cutting Machines, Used Machines) offered as a dropdown on the Inventory
// Product Creation form - see ProductTypeController/Service. Not a foreign
// key relation: Promotion.productType stays a plain string (see comment on
// that field) so existing listings are unaffected if a type is renamed or
// removed later. Seeded with the previously-hardcoded default types so the
// dropdown is never empty out of the box.
model ProductType {
  id   String @id @default(uuid())
  name String @unique

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

// Super-Admin-managed reference list of "key types" (e.g. Vehicle Key)
// offered as a dropdown next to the Key Code field on the Customer
// Registration form - see KeyTypeController/Service. Not a foreign key
// relation: Customer.keyType stays a plain string (mirrors
// Promotion.productType) so existing customers are unaffected if a type is
// renamed or removed later. Seeded with "Vehicle Key" as the default so the
// dropdown is never empty out of the box.
model KeyType {
  id   String @id @default(uuid())
  name String @unique

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

model Subscription {
  id        String             @id @default(uuid())
  shopId    String
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([shopId, status])
}

model MasterKey {
  id           String  @id @default(uuid())
  keyNumber    String
  category     String
  backImageUrl String?

  // Null shopId = legacy/global catalog entry. Shop admins create keys scoped
  // to their own shop during customer registration; super admin sees all.
  shopId String?
  shop   Shop?   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  customers Customer[]

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shopId, keyNumber])
  @@index([shopId])
  @@index([deletedAt])
  // Backs the Super Admin Master Catalogue screen's cross-shop cursor
  // pagination (WHERE deletedAt IS NULL ORDER BY keyNumber ASC) - see
  // KeyService.getKeys.
  @@index([deletedAt, keyNumber])
}

model Customer {
  id              String             @id @default(uuid())
  shopId          String
  shop            Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  address         String?
  idProofType     String?
  idProofNumber   String? // Encrypted PII at rest
  reason          String?
  // Optional - the 2-page registration wizard now lets the shop admin skip
  // entering a key code entirely (toggled off on Page 2), e.g. for a
  // customer visit that doesn't involve cutting/duplicating a key yet. A
  // blank keyNumber means no MasterKey catalog entry was auto-created and no
  // duplicate-key check ran for this record (see CustomerService.createCustomer).
  keyNumber       String?
  keyType         String?
  vehicleNumber   String?
  masterKeyId     String?
  masterKey       MasterKey?         @relation(fields: [masterKeyId], references: [id], onDelete: SetNull)
  latitude        Float?
  longitude       Float?
  mapsLink        String?
  capturedAddress String?
  photoUrl        String?
  documents       CustomerDocument[]
  reports         CustomerReport[]

  // Added for the 2-page registration wizard's Page 2 (optional, individually
  // toggled fields) and the compact single-page report.
  billAmount     Float?
  billNumber     String? @unique
  vehicleName    String?
  lostKey        Boolean @default(false)
  addKey         Boolean @default(false)
  homeOfficeName String?
  // Which of the 5 icon categories the shop admin picked on Page 1 of the
  // registration wizard - one of 'TWO_WHEELER' | 'FOUR_WHEELER' |
  // 'TRUCK_LORRY' | 'HOME' | 'OFFICE'. Free-form string (not a Prisma enum)
  // to match the keyType/documentType precedent elsewhere in this schema -
  // new categories can be added without a migration. The app groups the
  // first three as "Automobile" and the last two as "Domestic" purely in
  // code (see frontend/src/utils/vehicleCategory.js) - those words are
  // never persisted or shown in the UI.
  vehicleCategory String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([masterKeyId])
  @@index([shopId, deletedAt])
  @@index([shopId, phone])
  // Backs the Super Admin Customer Registry's cross-shop cursor pagination
  // (no shopId filter, ORDER BY createdAt DESC) - see CustomerService.getSuperCustomers.
  @@index([deletedAt, createdAt])
  // Backs the Shop Admin Customer History screen's cursor pagination
  // (WHERE shopId = X AND deletedAt IS NULL ORDER BY createdAt DESC) - see
  // CustomerService.getCustomers.
  @@index([shopId, deletedAt, createdAt])
}

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documentType String
  fileUrl      String // Local/object-storage path
  fileKey      String // Unique file key
  fileSize     Int // bytes
  originalName String? // Original client-side filename (for download), when known

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([deletedAt])
}

// A generated Customer Key Registration Report PDF, uploaded once (from the
// client, which is what actually builds the PDF via html2canvas/jsPDF) so it
// can be handed out as a stable, shareable download link - see
// PublicReportController. `id` IS the public link token: a random UUID
// unconnected to Customer.id or any other identifier, so the link can be
// safely shared (WhatsApp, SMS) without leaking which customer/shop it
// belongs to or exposing the underlying Supabase Storage path. The bucket
// itself stays private; every download re-signs a short-lived URL against
// `fileKey` on the fly (see FileService.getSignedDownloadUrl) rather than
// this row ever storing/exposing a long-lived signed URL.
model CustomerReport {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fileKey    String // Supabase Storage object key (or local fallback filename)
  fileName   String // Meaningful download filename, e.g. Customer_Key_Registration_John_a1b2c3d4.pdf

  createdAt DateTime @default(now())

  @@index([customerId])
}

// Relational replacement for the legacy Shop.companyDetails.{shopPhoto,shopLicense,ownerAadhaar}
// base64-embedded JSON fields. Mirrors CustomerDocument's shape/pattern so both entities are
// managed consistently. documentType is a free-form string (not an enum) to allow new document
// categories to be added without a schema migration; the application currently uses the
// conventional values 'SHOP_PHOTO', 'SHOP_LICENSE' and 'OWNER_AADHAAR'.
model ShopDocument {
  id           String @id @default(uuid())
  shopId       String
  shop         Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  documentType String
  fileUrl      String // Local/object-storage path
  fileKey      String // Unique file key
  fileSize     Int    @default(0) // bytes
  originalName String? // Original client-side filename (for download), when known

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([shopId, documentType])
  @@index([deletedAt])
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  method     String
  purpose    String
  codeHash   String
  consumed   Boolean  @default(false)
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([identifier, purpose])
}

model Advertisement {
  id          String   @id @default(uuid())
  title       String
  imageUrl    String
  type        AdType
  startDate   DateTime
  endDate     DateTime
  priority    Int      @default(0)
  targetAll   Boolean  @default(true)
  targetShops String[] // Shop IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cross-shop marketplace listing: an advertisement or promotional product created
// by a Shop Admin that is visible to every shop on the platform (not just the
// creator's own shop). Deliberately kept separate from `Advertisement` (Super-Admin
// only campaign banners/popups) and `Product` (the internal KEE supply-store
// catalog) to avoid conflating three distinct concerns. Intentionally NOT added to
// TENANT_SCOPED_MODELS in tenant.service.ts - reads must span all shops. Ownership
// for update/delete is instead enforced explicitly in PromotionService via a
// findFirst({ where: { id, shopId } }) check, mirroring ShopService.deleteShopDocument.
model Promotion {
  id          String        @id @default(uuid())
  type        PromotionType
  title       String
  description String?
  imageUrl    String?
  price       Float?

  // Inventory rework: freeform product category shown on the OLX-style
  // inventory grid. Nullable/additive so existing rows are unaffected. As of
  // the "Product Type" rework, this is the ONLY category classification a
  // listing has - the frontend's old separate AD/OFFER "Listing Type" picker
  // was removed, and this field is now driven by a fixed dropdown (Key
  // Cutting Machines, Used Machines, ECM Service, Meter Service, Scanning
  // Service) instead of the earlier free-text inventory categories.
  productType String?

  // Seller contact number shown on the listing card as a tap-to-call button.
  // Nullable so pre-existing rows created before this field was added remain
  // valid; the create form requires it for every new listing going forward.
  phone String?

  // Only meaningful for type === OFFER: a percentage discount and/or an expiry
  // (validUntil null = no expiry). The cross-shop feed excludes expired offers
  // by default - see PromotionService.getAllPromotions.
  discountPercentage Float?
  validUntil         DateTime?

  // Optional: an OFFER may reference the specific PRODUCT/AD listing (usually
  // from the same shop) that it is discounting. Nullable so a shop can also
  // publish a standalone/general offer with no specific linked listing.
  linkedPromotionId String?
  linkedPromotion   Promotion?  @relation("PromotionOffers", fields: [linkedPromotionId], references: [id], onDelete: SetNull)
  offers            Promotion[] @relation("PromotionOffers")

  // Nullable: a Super-Admin-created inventory product has shopId = null,
  // meaning it's independent of every shop's inventory (mirrors
  // MasterKey.shopId's "null = global catalog entry" pattern). Shop-Admin
  // listings always have a real shopId.
  shopId      String?
  shop        Shop?  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId])
  @@index([deletedAt])
  @@index([type])
  @@index([linkedPromotionId])
  // Backs the Machines/Inventory feed's cursor pagination (ORDER BY createdAt
  // DESC) and its category filter chips (WHERE productType = ...) - see
  // PromotionService.getAllPromotions.
  @@index([createdAt])
  @@index([productType])
}

model ActivityLog {
  id        String  @id @default(uuid())
  shopId    String?
  shop      Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. LOGIN, CUSTOMER_CREATE
  details   String // JSON string or description, PII masked
  ipAddress String?

  createdAt DateTime @default(now())

  // ActivityLog is an immutable audit trail: entries are never soft- or hard-deleted
  // by application code (no deletedAt field), and shopId/userId indexes keep the
  // Super Admin / Shop Admin activity views fast.
  @@index([shopId])
  @@index([userId])
  @@index([action])
}

model Notification {
  id      String  @id @default(uuid())
  shopId  String? // null for system-wide notifications (see `audience` for who those reach)
  shop    Shop?   @relation(fields: [shopId], references: [id], onDelete: SetNull)
  title   String
  message String
  type    String // e.g. SUB_EXPIRY, NEW_KEY, SHOP_REGISTRATION, ORDER_STATUS

  // Only meaningful when shopId is null (a shop-specific notification is always
  // scoped to that one shop regardless of this field). Distinguishes two different
  // kinds of "no specific shop" notifications that must NOT be conflated:
  //   'SHOP'        - a true global broadcast intended for every shop admin
  //                    (e.g. a platform-wide announcement/maintenance notice).
  //   'SUPER_ADMIN' - an internal/system notification for the Super Admin panel
  //                    only (e.g. "new shop X requests approval") - must never
  //                    be visible to any shop admin, including the shop that
  //                    triggered it.
  audience String @default("SHOP")

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([shopId])
  @@index([shopId, audience])
  // Supports the `orderBy: createdAt desc` used by both
  // NotificationService.getNotifications (shopId equality) and
  // getSuperNotifications (shopId: null equality) now that both are
  // capped with `take` instead of returning every row unbounded.
  @@index([shopId, createdAt])
}

model RevenueRecord {
  id     String  @id @default(uuid())
  month  Int
  year   Int
  amount Float
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Supports ReportService.logRevenue's WHERE {month, year} lookup and both
  // ReportService.getRevenueRecords/getSuperDashboard's ORDER BY year, month.
  @@index([year, month])
}

// Singleton row (fixed id "default") holding the Super Admin-managed global
// support contact/training-video config shown to every shop. Previously
// this was read/written to a hardcoded local file path left over from dev,
// which crashed on any host other than that one machine - moved to
// Postgres so it's both portable and durable across container restarts.
model PlatformConfig {
  id        String   @id @default("default")
  whatsapp  String   @default("+91 98765 43210")
  videos    Json     @default("[]")

  // Single yearly subscription price applied platform-wide - the only
  // configurable subscription rate now that all shops are on one plan tier.
  subscriptionPrice Float @default(999)

  // GST percentage added on top of subscriptionPrice when charging via
  // Razorpay - see PaymentService.createSubscriptionOrder. 18% is the
  // standard GST rate for SaaS/digital services in India.
  gstPercent Float @default(18)

  // Super Admin contact details shown on the shop-facing "Support Contact"
  // screen (reached from the bottom nav's Customer Service icon). Nullable so
  // existing deployments aren't required to backfill them immediately.
  email               String?
  customerCareNumber  String?

  updatedAt DateTime @updatedAt
}
